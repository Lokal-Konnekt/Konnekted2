<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Voice capture is unused; the removed visualizer no longer needs it either. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:node="remove" />
    <queries><package android:name="com.discord" /></queries>
    <application>
        <!-- Presence-only bridge: remove SDK-owned foreground mic service; no microphone needed. -->
        <service android:name="com.discord.socialsdk.ForegroundService" tools:node="remove" />
        <activity android:name="com.discord.socialsdk.AuthenticationActivity" tools:node="remove" />
    </application>
</manifest>
